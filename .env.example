# Server-side Anthropic API key used by the AI routes (set this in Vercel → Project → Settings → Environment Variables).
# If it is not set, each visitor can paste their own key in Settings; the app also has a no-key "heuristic" mode.
ANTHROPIC_API_KEY=

# Only if the key above was created at organisation level (not inside a workspace):
# the workspace to bill requests to, from Anthropic Console → Settings → Workspaces.
# ANTHROPIC_WORKSPACE_ID=wrkspc_01...

# Optional: override the Claude model (default: claude-opus-5-5).
# ANTHROPIC_MODEL=claude-opus-5-5
