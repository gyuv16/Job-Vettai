# Free AI engines (no credit card). Set them in Vercel → Project → Settings → Environment Variables.
# Mistral is the main engine; Groq answers when Mistral is busy. Set one or both.
# Without any key, every page still works with the free built-in engine.
MISTRAL_API_KEY=
GROQ_API_KEY=

# Optional: other models (defaults: mistral-medium-latest and openai/gpt-oss-120b,
# each falling back to mistral-small-latest / openai/gpt-oss-20b).
# MISTRAL_MODEL=mistral-medium-latest
# GROQ_MODEL=openai/gpt-oss-120b

# Optional and paid: an Anthropic API key, tried after the free engines.
# Visitors can also paste their own Claude key in Settings.
# ANTHROPIC_API_KEY=

# Only if the Anthropic key was created at organisation level (not inside a workspace):
# the workspace to bill requests to, from Anthropic Console → Settings → Workspaces.
# ANTHROPIC_WORKSPACE_ID=wrkspc_01...

# Optional: override the Claude model (default: claude-opus-5-5).
# ANTHROPIC_MODEL=claude-opus-5-5

# Optional: a passphrase visitors must enter in Settings before this site's AI keys are used.
# APP_ACCESS_CODE=
